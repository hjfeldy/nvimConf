{
  "neoWin": {
    "useDotenv": true,
    "env": {
      "TEST": "DEFAULT",
      "NOT_OVERRIDE": "HI"
    },
    "logging": {
      "vimConf.debugger": {
        "level": "DEBUG"
      },
      "GLOBAL": {
        "level": "INFO"
      },
      "Terminals": {
        "level": "INFO",
        "format": "[{label}::{logMethod}] {msg}",
        "withinLevelFilters": [ ],
        "levelOverrideFilters": [ 
          {"logMethod": "cycleTerm"}
        ]
      }
    }
  }
}
